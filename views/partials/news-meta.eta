<p class="small text-body-secondary mb-3">
  <%= it.fmt.formatDate(it.post.created_at) %>
  <% if (it.post.author) { %> · von <%= it.post.author %><% } %>
  <% if (it.post.updated_at) { %> · bearbeitet <%= it.fmt.formatDate(it.post.updated_at) %><% } %>
  <% if (!it.post.published) { %> <span class="badge text-bg-warning">Entwurf</span><% } %>
</p>