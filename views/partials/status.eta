<% const s = it.status %>
<div class="card shadow-sm">
  <div class="card-header d-flex justify-content-between align-items-center">
    <span class="fw-semibold">Server-Status</span>
    <% if (s.online) { %>
      <span class="badge text-bg-success">Online</span>
    <% } else { %>
      <span class="badge text-bg-danger">Offline</span>
    <% } %>
  </div>

  <% if (s.online) { %>
    <% const usage = s.maxClients > 0 ? Math.round((s.clientsOnline / s.maxClients) * 100) : 0 %>
    <div class="card-body pb-2">
      <div class="d-flex justify-content-between small mb-1">
        <span>Clients online</span>
        <span><%= s.clientsOnline %> / <%= s.maxClients %></span>
      </div>
      <div class="progress" role="progressbar" aria-label="Server-Auslastung"
           aria-valuenow="<%= usage %>" aria-valuemin="0" aria-valuemax="100">
        <div class="progress-bar" style="width: <%= usage %>%"></div>
      </div>
    </div>
    <ul class="list-group list-group-flush small">
      <li class="list-group-item d-flex justify-content-between">
        <span class="text-body-secondary">Uptime</span>
        <span><%= it.fmt.formatDuration(s.uptime) %></span>
      </li>
      <li class="list-group-item d-flex justify-content-between">
        <span class="text-body-secondary">Channels</span>
        <span><%= s.channels %></span>
      </li>
      <li class="list-group-item d-flex justify-content-between">
        <span class="text-body-secondary">Ping</span>
        <span><%= it.fmt.formatNumber(s.ping) %> ms</span>
      </li>
      <li class="list-group-item d-flex justify-content-between">
        <span class="text-body-secondary">Paketverlust</span>
        <span><%= it.fmt.formatNumber(s.packetLoss, 2) %> %</span>
      </li>
      <li class="list-group-item d-flex justify-content-between gap-3">
        <span class="text-body-secondary">Version</span>
        <span class="text-end"><%= s.version %></span>
      </li>
      <li class="list-group-item d-flex justify-content-between">
        <span class="text-body-secondary">Plattform</span>
        <span><%= s.platform %></span>
      </li>
    </ul>
  <% } else { %>
    <div class="card-body text-body-secondary small">
      Der TeamSpeak-Server ist gerade nicht erreichbar.
    </div>
  <% } %>

  <div class="card-footer">
    <div class="small text-body-secondary mb-2">Adresse: <code><%= s.address %></code></div>
    <% if (s.online) { %>
      <a class="btn btn-primary w-100" href="<%= s.connectUrl %>">Verbinden</a>
    <% } else { %>
      <a class="btn btn-primary w-100 disabled" aria-disabled="true">Verbinden</a>
    <% } %>
  </div>
</div>