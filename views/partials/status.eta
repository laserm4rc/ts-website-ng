<% const s = it.status %>
<% const percent = s.maxClients > 0 ? Math.round((s.clientsOnline / s.maxClients) * 100) : 0 %>
<div class="card shadow-sm">
  <div class="card-header fw-semibold">
    <i class="bi bi-reception-4 me-2"></i><%= it.t('status.title') %>
  </div>

  <div class="card-body sidebar-list">
    <div class="sidebar-row">
      <i class="bi bi-globe sidebar-icon"></i>
      <span class="sidebar-label"><%= it.t('status.address') %></span>
      <span class="sidebar-value fw-semibold text-truncate"><%= s.address %></span>
    </div>

    <div class="sidebar-row">
      <i class="bi bi-power sidebar-icon"></i>
      <span class="sidebar-label"><%= it.t('status.online') %></span>
      <% if (s.online) { %>
        <span class="sidebar-value badge rounded-pill text-bg-primary"><%= s.clientsOnline %> / <%= s.maxClients %> (<%= percent %>%)</span>
      <% } else { %>
        <span class="sidebar-value badge rounded-pill text-bg-danger"><%= it.t('common.offline') %></span>
      <% } %>
    </div>

    <% if (s.online) { %>
      <div class="sidebar-row">
        <i class="bi bi-trophy-fill sidebar-icon"></i>
        <span class="sidebar-label"><%= it.t('status.topOnline') %></span>
        <span class="sidebar-value badge rounded-pill text-bg-primary"><%= s.topOnline %></span>
      </div>

      <div class="sidebar-row">
        <i class="bi bi-clock-fill sidebar-icon"></i>
        <span class="sidebar-label"><%= it.t('status.uptime') %></span>
        <span class="sidebar-value badge rounded-pill text-bg-primary"><%= it.fmt.formatUptime(s.uptime) %></span>
      </div>

      <div class="sidebar-row">
        <i class="bi bi-info-circle-fill sidebar-icon"></i>
        <span class="sidebar-label"><%= it.t('status.version') %></span>
        <span class="sidebar-value badge rounded-pill text-bg-primary">
          <%= it.t('status.versionOn', { version: s.version }) %>
          <i class="bi <%= s.platformIcon %>" title="<%= s.platform %>"></i>
        </span>
      </div>

      <div class="sidebar-row">
        <i class="bi bi-bar-chart-fill sidebar-icon"></i>
        <span class="sidebar-label"><%= it.t('status.ping') %></span>
        <span class="sidebar-value badge rounded-pill text-bg-primary"><%= it.fmt.formatNumber(s.ping, 2) %> ms</span>
      </div>

      <div class="sidebar-row">
        <i class="bi bi-lightning-charge-fill sidebar-icon"></i>
        <span class="sidebar-label"><%= it.t('status.packetLoss') %></span>
        <span class="sidebar-value badge rounded-pill text-bg-primary"><%= it.fmt.formatNumber(s.packetLoss, 2) %>%</span>
      </div>
    <% } %>
  </div>

  <div class="card-footer">
    <% if (s.online) { %>
      <a class="btn btn-primary w-100" href="<%= s.connectUrl %>"><%= it.t('status.connect') %></a>
    <% } else { %>
      <a class="btn btn-primary w-100 disabled" aria-disabled="true"><%= it.t('status.connect') %></a>
    <% } %>
  </div>
</div>
