<% if (it.adminStatus && it.adminStatus.enabled) { %>
  <div class="card shadow-sm mt-4">
    <div class="card-header fw-semibold">
      <i class="bi bi-person-badge-fill me-2"></i><%= it.t('team.title') %>
    </div>

    <% if (!it.adminStatus.online) { %>
      <div class="card-body text-body-secondary small"><%= it.t('team.unavailable') %></div>
    <% } else if (it.adminStatus.groups.length === 0) { %>
      <div class="card-body text-body-secondary small"><%= it.t('team.nobodyOnline') %></div>
    <% } else { %>
      <div class="card-body team-list">
        <% it.adminStatus.groups.forEach((group) => { %>
          <div class="team-group">
            <div class="team-group-title">
              <% if (group.iconId > 0) { %>
                <%~ include('./group-icon', { group }) %>
              <% } %>
              <span><%= group.name %></span>
            </div>
            <% group.members.forEach((member) => { %>
              <div class="sidebar-row">
                <span class="text-truncate"><%= member.nickname || it.t('common.unknown') %></span>
                <span class="sidebar-value badge rounded-pill <%= member.badge %>" title="<%= member.awayMessage %>">
                  <%= it.t(member.labelKey) %><% if (member.awayMessage) { %> <i class="bi bi-chat-dots-fill"></i><% } %>
                </span>
              </div>
            <% }) %>
          </div>
        <% }) %>
      </div>
    <% } %>
  </div>
<% } %>
