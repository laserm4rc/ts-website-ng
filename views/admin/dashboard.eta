<% layout('./layout') %>

<% if (it.welcome) { %>
  <div class="alert alert-success">
    <%= it.t('admin.dashboard.welcome', { username: it.user.username }) %>
  </div>
<% } %>

<h1 class="h3 mb-4"><%= it.t('admin.nav.dashboard') %></h1>

<div class="row g-4">
  <div class="col-md-6">
    <div class="card h-100">
      <div class="card-body">
        <h2 class="h5 card-title"><%= it.t('admin.dashboard.server') %></h2>
        <% if (it.status.online) { %>
          <p class="mb-1"><span class="badge text-bg-success"><%= it.t('common.online') %></span> <%= it.status.name %></p>
          <p class="mb-0 text-body-secondary">
            <%= it.t('admin.dashboard.clients', { online: it.status.clientsOnline, max: it.status.maxClients }) %> ·
            <%= it.t('admin.dashboard.uptime', { duration: it.fmt.formatDuration(it.status.uptime) }) %>
          </p>
        <% } else { %>
          <p class="mb-0"><span class="badge text-bg-danger"><%= it.t('common.offline') %></span> <%= it.t('admin.dashboard.queryUnreachable') %></p>
        <% } %>
      </div>
    </div>
  </div>

  <div class="col-md-6">
    <div class="card h-100">
      <div class="card-body">
        <h2 class="h5 card-title"><%= it.t('admin.dashboard.manage') %></h2>
        <ul class="mb-0">
          <li><a href="/admin/news"><%= it.t('admin.dashboard.manageNews') %></a></li>
          <li><a href="/admin/pages/rules"><%= it.t('admin.dashboard.editRules') %></a></li>
          <li><a href="/admin/faq"><%= it.t('admin.dashboard.manageFaq') %></a></li>
          <li><a href="/admin/pages/imprint"><%= it.t('admin.dashboard.editImprint') %></a></li>
          <li><a href="/admin/adminstatus"><%= it.t('admin.dashboard.configureAdminStatus') %></a></li>
          <li><a href="/admin/settings"><%= it.t('admin.settings.title') %></a></li>
          <li><a href="/admin/account"><%= it.t('admin.dashboard.changePassword') %></a></li>
        </ul>
      </div>
    </div>
  </div>
</div>
