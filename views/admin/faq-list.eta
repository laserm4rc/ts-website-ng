<% layout('./layout') %>

<div class="d-flex justify-content-between align-items-center mb-4">
  <h1 class="h3 mb-0">FAQ</h1>
  <a href="/admin/faq/new" class="btn btn-primary">+ Neue Frage</a>
</div>

<% if (it.notice) { %>
  <div class="alert alert-success"><%= it.notice %></div>
<% } %>

<% if (it.items.length === 0) { %>
  <div class="card card-body text-body-secondary">Noch keine Fragen. Leg die erste an!</div>
<% } else { %>
  <div class="table-responsive">
    <table class="table align-middle">
      <thead>
        <tr>
          <th>Reihenfolge</th>
          <th>Frage</th>
          <th class="text-end">Aktionen</th>
        </tr>
      </thead>
      <tbody>
        <% it.items.forEach((item, index) => { %>
          <tr>
            <td class="text-nowrap">
              <form method="post" action="/admin/faq/<%= item.id %>/move" class="btn-group btn-group-sm">
                <input type="hidden" name="_csrf" value="<%= it.csrf %>">
                <button type="submit" name="direction" value="up" class="btn btn-outline-secondary"
                        aria-label="Nach oben"<%= index === 0 ? ' disabled' : '' %>>↑</button>
                <button type="submit" name="direction" value="down" class="btn btn-outline-secondary"
                        aria-label="Nach unten"<%= index === it.items.length - 1 ? ' disabled' : '' %>>↓</button>
              </form>
            </td>
            <td><a href="/admin/faq/<%= item.id %>/edit"><%= item.question %></a></td>
            <td class="text-end text-nowrap">
              <a href="/admin/faq/<%= item.id %>/edit" class="btn btn-sm btn-outline-primary">Bearbeiten</a>
              <form method="post" action="/admin/faq/<%= item.id %>/delete" class="d-inline"
                    onsubmit="return confirm('Diese Frage wirklich löschen?')">
                <input type="hidden" name="_csrf" value="<%= it.csrf %>">
                <button type="submit" class="btn btn-sm btn-outline-danger">Löschen</button>
              </form>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
<% } %>