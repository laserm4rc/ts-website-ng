<% layout('./layout') %>

<div class="d-flex justify-content-between align-items-center mb-4">
  <h1 class="h3 mb-0"><%= it.t('admin.faq.title') %></h1>
  <a href="/admin/faq/new" class="btn btn-primary"><%= it.t('admin.faq.add') %></a>
</div>

<% if (it.notice) { %>
  <div class="alert alert-success"><%= it.notice %></div>
<% } %>

<% if (it.items.length === 0) { %>
  <div class="card card-body text-body-secondary"><%= it.t('admin.faq.empty') %></div>
<% } else { %>
  <div class="table-responsive">
    <table class="table align-middle">
      <thead>
        <tr>
          <th><%= it.t('admin.faq.colOrder') %></th>
          <th><%= it.t('admin.faq.colQuestion') %></th>
          <th class="text-end"><%= it.t('common.actions') %></th>
        </tr>
      </thead>
      <tbody>
        <% it.items.forEach((item, index) => { %>
          <tr>
            <td class="text-nowrap">
              <form method="post" action="/admin/faq/<%= item.id %>/move" class="btn-group btn-group-sm">
                <input type="hidden" name="_csrf" value="<%= it.csrf %>">
                <button type="submit" name="direction" value="up" class="btn btn-outline-secondary"
                        aria-label="<%= it.t('admin.faq.moveUp') %>"<%= index === 0 ? ' disabled' : '' %>>↑</button>
                <button type="submit" name="direction" value="down" class="btn btn-outline-secondary"
                        aria-label="<%= it.t('admin.faq.moveDown') %>"<%= index === it.items.length - 1 ? ' disabled' : '' %>>↓</button>
              </form>
            </td>
            <td><a href="/admin/faq/<%= item.id %>/edit"><%= item.question %></a></td>
            <td class="text-end text-nowrap">
              <a href="/admin/faq/<%= item.id %>/edit" class="btn btn-sm btn-outline-primary"><%= it.t('common.edit') %></a>
              <form method="post" action="/admin/faq/<%= item.id %>/delete" class="d-inline"
                    data-confirm="<%= it.t('admin.faq.confirmDelete') %>">
                <input type="hidden" name="_csrf" value="<%= it.csrf %>">
                <button type="submit" class="btn btn-sm btn-outline-danger"><%= it.t('common.delete') %></button>
              </form>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
<% } %>
