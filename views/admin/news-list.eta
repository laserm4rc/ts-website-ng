<% layout('./layout') %>

<div class="d-flex justify-content-between align-items-center mb-4">
  <h1 class="h3 mb-0"><%= it.t('news.title') %></h1>
  <a href="/admin/news/new" class="btn btn-primary"><%= it.t('admin.news.add') %></a>
</div>

<% if (it.notice) { %>
  <div class="alert alert-success"><%= it.notice %></div>
<% } %>

<% if (it.items.length === 0) { %>
  <div class="card card-body text-body-secondary"><%= it.t('admin.news.empty') %></div>
<% } else { %>
  <div class="table-responsive">
    <table class="table align-middle">
      <thead>
        <tr>
          <th><%= it.t('admin.news.colTitle') %></th>
          <th><%= it.t('common.status') %></th>
          <th><%= it.t('admin.news.colCreated') %></th>
          <th class="text-end"><%= it.t('common.actions') %></th>
        </tr>
      </thead>
      <tbody>
        <% it.items.forEach((post) => { %>
          <tr>
            <td><a href="/admin/news/<%= post.id %>/edit"><%= post.title %></a></td>
            <td>
              <% if (post.published) { %>
                <span class="badge text-bg-success"><%= it.t('admin.news.published') %></span>
              <% } else { %>
                <span class="badge text-bg-warning"><%= it.t('admin.news.draft') %></span>
              <% } %>
            </td>
            <td class="small text-nowrap"><%= it.fmt.formatDate(post.created_at) %></td>
            <td class="text-end text-nowrap">
              <% if (it.visible.news) { %>
                <a href="/news/<%= post.id %>" target="_blank" class="btn btn-sm btn-outline-secondary"><%= it.t('common.view') %></a>
              <% } %>
              <a href="/admin/news/<%= post.id %>/edit" class="btn btn-sm btn-outline-primary"><%= it.t('common.edit') %></a>
              <form method="post" action="/admin/news/<%= post.id %>/delete" class="d-inline"
                    data-confirm="<%= it.t('admin.news.confirmDelete') %>">
                <input type="hidden" name="_csrf" value="<%= it.csrf %>">
                <button type="submit" class="btn btn-sm btn-outline-danger"><%= it.t('common.delete') %></button>
              </form>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
<% } %>
