<!doctype html>
<html lang="en" data-bs-theme="dark">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="robots" content="noindex">
  <title><%= it.title %> · Admin · <%= it.site.name %></title>
  <link rel="stylesheet" href="/vendor/bootstrap/css/bootstrap.min.css">
  <link rel="stylesheet" href="/vendor/bootstrap-icons/bootstrap-icons.min.css">
  <link rel="stylesheet" href="/static/css/style.css">
</head>
<body class="d-flex flex-column min-vh-100">
  <nav class="navbar navbar-expand-xl bg-body-tertiary border-bottom">
    <div class="container">
      <a class="navbar-brand fw-semibold" href="<%= it.user ? '/admin' : '/' %>">
        <%= it.site.name %> <span class="badge text-bg-secondary ms-1">Admin</span>
      </a>

      <% if (it.user) { %>
        <% const adminNav = [
          { href: '/admin', key: 'admin.nav.dashboard', active: it.path === '/admin' },
          { href: '/admin/news', key: 'nav.news', active: it.path.startsWith('/admin/news') },
          { href: '/admin/pages/rules', key: 'nav.rules', active: it.path === '/admin/pages/rules' },
          { href: '/admin/faq', key: 'nav.faq', active: it.path.startsWith('/admin/faq') },
          { href: '/admin/pages/imprint', key: 'nav.imprint', active: it.path === '/admin/pages/imprint' },
          { href: '/admin/adminstatus', key: 'admin.nav.adminStatus', active: it.path === '/admin/adminstatus' },
          { href: '/admin/settings', key: 'admin.nav.settings', active: it.path === '/admin/settings' },
        ] %>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#adminNav"
                aria-controls="adminNav" aria-expanded="false" aria-label="<%= it.t('nav.toggle') %>">
          <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="adminNav">
          <ul class="navbar-nav me-auto">
            <% adminNav.forEach((item) => { %>
              <li class="nav-item">
                <a class="nav-link<%= item.active ? ' active' : '' %>" href="<%= item.href %>"><%= it.t(item.key) %></a>
              </li>
            <% }) %>
          </ul>
          <ul class="navbar-nav align-items-xl-center gap-xl-2">
            <li class="nav-item"><a class="nav-link" href="/"><%= it.t('admin.nav.website') %></a></li>
            <li class="nav-item">
              <a class="nav-link<%= it.path === '/admin/account' ? ' active' : '' %>" href="/admin/account">
                <%= it.user.username %>
              </a>
            </li>
            <li class="nav-item">
              <form method="post" action="/logout" class="d-inline">
                <input type="hidden" name="_csrf" value="<%= it.csrf %>">
                <button type="submit" class="btn btn-sm btn-outline-secondary"><%= it.t('admin.nav.logout') %></button>
              </form>
            </li>
          </ul>
        </div>
      <% } %>
    </div>
  </nav>

  <main class="container py-4 flex-grow-1">
    <%~ it.body %>
  </main>

  <script src="/vendor/bootstrap/js/bootstrap.bundle.min.js"></script>
  <script src="/static/js/app.js" defer></script>
</body>
</html>
