<% layout('./layout') %>

<h1 class="h3 mb-4"><%= it.t('admin.adminStatus.title') %></h1>

<% if (it.saved) { %>
  <div class="alert alert-success"><%= it.t('common.saved') %></div>
<% } %>

<% if (!it.online) { %>
  <div class="alert alert-warning"><%= it.t('admin.adminStatus.unreachable') %></div>
<% } else { %>
  <form method="post" action="/admin/adminstatus" class="card card-body gap-3" style="max-width: 36rem">
    <input type="hidden" name="_csrf" value="<%= it.csrf %>">

    <div>
      <div class="form-label"><%= it.t('admin.adminStatus.groups') %></div>
      <% it.groups.forEach((group) => { %>
        <div class="form-check">
          <input class="form-check-input" type="checkbox" id="group-<%= group.id %>" name="groups"
                 value="<%= group.id %>"<%= it.selected.includes(group.id) ? ' checked' : '' %>>
          <label class="form-check-label" for="group-<%= group.id %>"><%= group.name %></label>
        </div>
      <% }) %>
      <div class="form-text"><%= it.t('admin.adminStatus.groupsHint') %></div>
    </div>

    <div class="form-check">
      <input class="form-check-input" type="checkbox" id="hideOffline" name="hideOffline" value="1"<%= it.hideOffline ? ' checked' : '' %>>
      <label class="form-check-label" for="hideOffline"><%= it.t('admin.adminStatus.hideOffline') %></label>
    </div>

    <div>
      <button type="submit" class="btn btn-primary"><%= it.t('common.save') %></button>
    </div>
  </form>
<% } %>
