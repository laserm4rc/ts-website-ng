<% layout('./layout') %>

<div class="d-flex justify-content-between align-items-center mb-4">
  <h1 class="h3 mb-0"><%= it.title %></h1>
  <a href="/admin/faq" class="btn btn-sm btn-outline-secondary"><%= it.t('common.backToList') %></a>
</div>

<% if (it.errors.length > 0) { %>
  <div class="alert alert-danger">
    <ul class="mb-0"><% it.errors.forEach((error) => { %><li><%= error %></li><% }) %></ul>
  </div>
<% } %>

<form method="post" action="/admin/faq<%= it.isNew ? '' : '/' + it.id %>" class="card card-body gap-3">
  <input type="hidden" name="_csrf" value="<%= it.csrf %>">

  <div>
    <label class="form-label" for="question"><%= it.t('admin.faq.fieldQuestion') %></label>
    <input class="form-control" id="question" name="question" required maxlength="200"
           value="<%= it.values.question %>">
  </div>

  <div>
    <label class="form-label" for="answer"><%= it.t('admin.faq.fieldAnswer') %></label>
    <textarea class="form-control font-monospace" id="answer" name="answer" rows="10" required
              maxlength="10000"><%= it.values.answer %></textarea>
    <div class="form-text"><%= it.t('common.markdownHint') %></div>
  </div>

  <div>
    <button type="submit" class="btn btn-primary"><%= it.t('common.save') %></button>
  </div>
</form>
