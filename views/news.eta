<% layout('./layout') %>

<article class="card">
  <div class="card-body">
    <h1 class="h3 card-title"><%= it.post.title %></h1>
    <%~ include('./partials/news-meta', { post: it.post, fmt: it.fmt }) %>
    <div class="news-content">
      <%~ it.md(it.post.content) %>
    </div>
  </div>
  <div class="card-footer d-flex justify-content-between">
    <a href="/" class="btn btn-sm btn-outline-secondary">« Alle News</a>
    <% if (it.user) { %>
      <a href="/admin/news/<%= it.post.id %>/edit" class="btn btn-sm btn-outline-primary">Bearbeiten</a>
    <% } %>
  </div>
</article>