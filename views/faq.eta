<% layout('./layout') %>

<div class="d-flex justify-content-between align-items-center mb-3">
  <h1 class="h3 mb-0"><%= it.t('faq.title') %></h1>
  <% if (it.user) { %>
    <a href="/admin/faq" class="btn btn-sm btn-outline-primary"><%= it.t('common.edit') %></a>
  <% } %>
</div>

<% if (it.items.length === 0) { %>
  <div class="card card-body text-body-secondary"><%= it.t('faq.empty') %></div>
<% } else { %>
  <div class="accordion" id="faqAccordion">
    <% it.items.forEach((item) => { %>
      <div class="accordion-item">
        <h2 class="accordion-header">
          <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse"
                  data-bs-target="#faq-<%= item.id %>" aria-expanded="false" aria-controls="faq-<%= item.id %>">
            <%= item.question %>
          </button>
        </h2>
        <div id="faq-<%= item.id %>" class="accordion-collapse collapse" data-bs-parent="#faqAccordion">
          <div class="accordion-body news-content">
            <%~ it.md(item.answer) %>
          </div>
        </div>
      </div>
    <% }) %>
  </div>
<% } %>
