<% layout('./layout') %>

<div class="card">
  <div class="card-header d-flex justify-content-between align-items-center">
    <span class="fw-semibold">Bannliste</span>
    <% if (it.bans.online) { %>
      <span class="badge text-bg-secondary"><%= it.bans.total %></span>
    <% } %>
  </div>

  <% if (!it.bans.online) { %>
    <div class="card-body text-body-secondary">Der TeamSpeak-Server ist gerade nicht erreichbar.</div>
  <% } else if (it.bans.items.length === 0) { %>
    <div class="card-body text-body-secondary">Aktuell gibt es keine Banns.</div>
  <% } else { %>
    <div class="table-responsive">
      <table class="table align-middle mb-0">
        <thead>
          <tr>
            <th>Name</th>
            <th>Grund</th>
            <th>Gebannt von</th>
            <th>Datum</th>
            <th>Läuft ab</th>
          </tr>
        </thead>
        <tbody>
          <% it.bans.items.forEach((ban) => { %>
            <tr>
              <td><%= ban.name || 'Unbekannt' %></td>
              <td><%= ban.reason || 'Kein Grund angegeben' %></td>
              <td><%= ban.invoker || '–' %></td>
              <td class="small text-nowrap"><%= it.fmt.formatDate(new Date(ban.createdAt * 1000)) %></td>
              <td class="small text-nowrap">
                <% if (ban.permanent) { %>
                  <span class="badge text-bg-danger">Permanent</span>
                <% } else { %>
                  in <%= it.fmt.formatDuration(ban.remaining) %>
                <% } %>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  <% } %>
</div>

<div class="mt-3">
  <%~ include('./partials/pagination', { page: it.bans.page, pages: it.bans.pages, baseUrl: '/bans' }) %>
</div>