<% layout('./layout') %>

<div class="card">
  <div class="card-header d-flex justify-content-between align-items-center">
    <span class="fw-semibold"><%= it.t('bans.title') %></span>
    <% if (it.bans.online) { %>
      <span class="badge text-bg-secondary"><%= it.bans.total %></span>
    <% } %>
  </div>

  <% if (!it.bans.online) { %>
    <div class="card-body text-body-secondary"><%= it.t('common.tsUnreachable') %></div>
  <% } else if (it.bans.items.length === 0) { %>
    <div class="card-body text-body-secondary"><%= it.t('bans.empty') %></div>
  <% } else { %>
    <div class="table-responsive">
      <table class="table align-middle mb-0">
        <thead>
          <tr>
            <th><%= it.t('bans.name') %></th>
            <th><%= it.t('bans.reason') %></th>
            <th><%= it.t('bans.invoker') %></th>
            <th><%= it.t('bans.date') %></th>
            <th><%= it.t('bans.expires') %></th>
          </tr>
        </thead>
        <tbody>
          <% it.bans.items.forEach((ban) => { %>
            <tr>
              <td><%= ban.name || it.t('common.unknown') %></td>
              <td><%= ban.reason || it.t('bans.noReason') %></td>
              <td><%= ban.invoker || '–' %></td>
              <td class="small text-nowrap"><%= it.fmt.formatDate(new Date(ban.createdAt * 1000)) %></td>
              <td class="small text-nowrap">
                <% if (ban.permanent) { %>
                  <span class="badge text-bg-danger"><%= it.t('bans.permanent') %></span>
                <% } else { %>
                  <%= it.t('bans.expiresIn', { duration: it.fmt.formatDuration(ban.remaining) }) %>
                <% } %>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  <% } %>
</div>

<div class="mt-3">
  <%~ include('./partials/pagination', { page: it.bans.page, pages: it.bans.pages, baseUrl: '/bans', t: it.t }) %>
</div>
