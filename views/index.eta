<% layout('./layout') %>

<h1 class="visually-hidden"><%= it.t('news.title') %></h1>

<% if (it.news.items.length === 0) { %>
  <div class="card card-body text-body-secondary"><%= it.t('news.empty') %></div>
<% } %>

<% it.news.items.forEach((post) => { %>
  <article class="card mb-4">
    <div class="card-body">
      <h2 class="h4 card-title">
        <a href="/news/<%= post.id %>" class="link-body-emphasis text-decoration-none"><%= post.title %></a>
      </h2>
      <%~ include('./partials/news-meta', { post, fmt: it.fmt, t: it.t }) %>

      <div class="news-content">
        <% if (post.summary) { %>
          <%~ it.md(post.summary) %>
          <a href="/news/<%= post.id %>" class="btn btn-sm btn-outline-primary"><%= it.t('news.readMore') %></a>
        <% } else { %>
          <%~ it.md(post.content) %>
        <% } %>
      </div>
    </div>
  </article>
<% }) %>

<%~ include('./partials/pagination', { page: it.news.page, pages: it.news.pages, baseUrl: '/', t: it.t }) %>
