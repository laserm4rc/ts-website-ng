<% layout('./admin/layout') %>

<div class="row justify-content-center">
  <div class="col-md-8 col-lg-6">
    <h1 class="h3 mb-2"><%= it.t('setup.title') %></h1>
    <p class="text-body-secondary"><%= it.t('setup.intro') %></p>

    <% if (it.errors.length > 0) { %>
      <div class="alert alert-danger">
        <ul class="mb-0">
          <% it.errors.forEach((error) => { %><li><%= error %></li><% }) %>
        </ul>
      </div>
    <% } %>

    <form method="post" action="/setup" class="card card-body gap-3">
      <div>
        <label class="form-label" for="setupToken"><%= it.t('setup.token') %></label>
        <input class="form-control font-monospace" id="setupToken" name="setupToken" required autocomplete="off">
      </div>
      <div>
        <label class="form-label" for="siteName"><%= it.t('setup.siteName') %></label>
        <input class="form-control" id="siteName" name="siteName" required maxlength="60"
               value="<%= it.values.siteName %>">
      </div>
      <hr class="my-1">
      <div>
        <label class="form-label" for="username"><%= it.t('setup.username') %></label>
        <input class="form-control" id="username" name="username" required maxlength="32"
               autocomplete="username" value="<%= it.values.username %>">
      </div>
      <div>
        <label class="form-label" for="password"><%= it.t('setup.password') %></label>
        <input class="form-control" type="password" id="password" name="password" required minlength="<%= it.minPassword %>"
               autocomplete="new-password">
        <div class="form-text"><%= it.t('setup.passwordHint', { min: it.minPassword }) %></div>
      </div>
      <div>
        <label class="form-label" for="passwordRepeat"><%= it.t('setup.passwordRepeat') %></label>
        <input class="form-control" type="password" id="passwordRepeat" name="passwordRepeat" required minlength="<%= it.minPassword %>"
               autocomplete="new-password">
      </div>
      <button type="submit" class="btn btn-primary"><%= it.t('setup.submit') %></button>
    </form>
  </div>
</div>
