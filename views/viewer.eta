<% layout('./layout') %>

<div class="card">
  <div class="card-header fw-semibold"><%= it.t('viewer.title') %></div>
  <div class="card-body">
    <div id="viewer-tree" data-live-url="/viewer/tree" data-refresh="<%= it.liveSeconds %>">
      <%~ include('./partials/viewer-tree', it) %>
    </div>
  </div>
</div>
