<% layout('./layout') %>

<div class="card">
  <div class="card-header fw-semibold">Server-Viewer</div>
  <div class="card-body">
    <div id="viewer-tree" data-refresh="<%= it.refreshSeconds %>">
      <%~ include('./partials/viewer-tree', it) %>
    </div>
  </div>
</div>

<script src="/static/js/viewer.js" defer></script>