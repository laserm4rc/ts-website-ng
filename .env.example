# Lokale Entwicklung
NODE_ENV=development
SERVER_PORT=3000
LOG_LEVEL=debug
SITE_NAME=Mein TeamSpeak

# TeamSpeak 3 ServerQuery
TS3_HOST=127.0.0.1
TS3_QUERY_PORT=10011
TS3_QUERY_USER=serveradmin
TS3_QUERY_PASSWORD=
# Voice-Port des virtuellen Servers (Standard 9987)
TS3_SERVER_PORT=9987
# Adresse, die Besucher zum Verbinden angezeigt bekommen
TS3_PUBLIC_ADDRESS=localhost
# Wie oft sich Status, Team-Box und Viewer aktualisieren (Sekunden)
TS3_CACHE_SECONDS=4

# Datenspeicher (SQLite-Datenbank). Standard: ./data
# DATA_DIR=./data

# Nur auf 1 setzen, wenn die Seite über HTTPS läuft
COOKIE_SECURE=0
# Nach so vielen Minuten ohne Aktivität im Admin-Bereich ist eine neue Anmeldung nötig
SESSION_IDLE_MINUTES=60